# Copie este arquivo para ".env" e preencha. Nunca envie o .env para ninguém.

# Banco MySQL (pode ser local, Railway, PlanetScale, TiDB Cloud, etc.)
DATABASE_URL=mysql://usuario:senha@localhost:3306/gestao_hectares

# Segredo que assina o login. Use um texto longo e aleatório (mínimo 32 caracteres).
# Para gerar um: openssl rand -hex 32
JWT_SECRET=

# Primeiro administrador: criado automaticamente na 1ª vez que o servidor sobe.
ADMIN_EMAIL=voce@empresa.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Opcional. Sem esta chave, "Encontrar fornecedores" usa o mapa gratuito (OpenStreetMap, até 100 km).
# Com a chave do Google (Places API New) a busca fica mais completa e vai até "Todo o Brasil".
GOOGLE_PLACES_API_KEY=

# Porta (opcional)
PORT=3000
